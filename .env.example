# Backend (Hono / Node.js) - modelo de variáveis de ambiente

# Porta local. Na Railway, deixe em branco/omita: a plataforma injeta PORT.
PORT=3001

# Ambiente. Em produção use "production" (habilita SSL na conexão com o Postgres).
NODE_ENV=production

# String de conexão do Postgres do Supabase (recomendado usar o Pooler, porta 6543).
DATABASE_URL=postgresql://postgres:SENHA@HOST:5432/postgres

# Segredo próprio do backend para assinar/validar os JWT da aplicação.
# Obrigatório em produção (≥32 caracteres).
JWT_SECRET=

# Tempo de vida do JWT (ex.: 8h, 1d). Padrão: 8h.
JWT_TTL=8h

# Origens permitidas no CORS (separadas por vírgula). Nunca use * em produção.
# Ex.: https://seu-dominio.hostinger.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Tamanho mínimo de senha (padrão 8). Exige também maiúscula, minúscula e número.
PASSWORD_MIN_LENGTH=8

# Chave da OpenAI para o assistente de IA (opcional).
OPENAI_API_KEY=

# Organization ID da OpenAI (opcional).
OPENAI_ORG_ID=
